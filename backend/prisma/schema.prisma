datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSettings {
  id                     Int      @id @default(1)
  businessName           String   @default("R.K. Ayurveda")
  logoUrl                String?
  faviconUrl             String?
  heroTitle              String   @default("Pure & Organic Ayurvedic Remedies")
  heroSubtitle           String   @default("Experience the healing power of nature with small-batch, authentic products.")
  heroImageUrl           String?
  heroButtonText         String   @default("View Medicines")
  heroButtonLink         String   @default("/medicines")
  heroVisible            Boolean  @default(true)
  aboutIntro             String   @default("Dedicated to bringing authentic Ayurvedic health and wellness to your home.")
  footerText             String   @default("© All rights reserved.")
  updatedAt              DateTime @updatedAt
}

model ContactDetails {
  id             Int      @id @default(1)
  businessName   String   @default("R.K. Organics")
  address        String   @default("123 Ayurvedic Lane, Heritage Town")
  phone          String   @default("+91 6305029231")
  whatsapp       String   @default("6305029231")
  email          String   @default("info@rkayurveda.com")
  googleMapsLink String   @default("https://maps.google.com")
  openingHours   String   @default("9:00 AM - 6:00 PM (Mon - Sat)")
  instagramUrl   String?  @default("https://instagram.com")
  facebookUrl    String?  @default("https://facebook.com")
  twitterUrl     String?  @default("https://twitter.com")
  updatedAt      DateTime @updatedAt
}

model AboutContent {
  id                    Int      @id @default(1)
  heading               String   @default("About Our Organisation")
  aboutIntro            String   @default("Dedicated to bringing authentic Ayurvedic health and wellness to your home.") @db.Text
  ourStory              String   @db.Text
  storyImageUrl         String?
  mission               String   @db.Text
  vision                String   @db.Text
  philosophyIntro       String   @default("Our approach is guided by timeless natural wisdom.") @db.Text
  qualityIntro          String   @default("We ensure transparency and care in every product.") @db.Text
  whyChooseUsIntro      String   @default("Why customers trust R.K. Ayurveda.") @db.Text
  valuesIntro           String   @default("The core principles that guide us.") @db.Text
  galleryTitle          String   @default("Inside R.K. Ayurveda")
  galleryIntro          String   @default("Take a look at our daily operations and products.") @db.Text
  certificationsTitle   String   @default("Our Certifications & Trust Standards")
  certificationsIntro   String   @default("Genuine business standards and registrations.") @db.Text
  certificationsEnabled Boolean  @default(false)
  ctaTitle              String   @default("Explore Our Ayurvedic Products")
  ctaButtonText         String   @default("View Medicines")
  ctaButtonLink         String   @default("/medicines")
  ctaWhatsAppText       String   @default("Order on WhatsApp")
  isEnabled             Boolean  @default(true)
  updatedAt             DateTime @updatedAt

  // Retain original fields to prevent breaking any queries
  philosophy            String   @default("Ayurveda is the science of life.")
  qualityInfo           String   @default("Every batch is prepared with strict adherence to traditional methods.")
  whyChooseUs           String   @default("100% natural formula, chemical-free processing, heritage-based recipes.")
  additionalContent     String?  @default("")
  imageUrl              String?
}

model AboutSection {
  id           String   @id // e.g. "hero", "story", "mission_vision", "philosophy", "quality", "why_choose_us", "values", "gallery", "certifications", "cta"
  title        String
  isEnabled    Boolean  @default(true)
  displayOrder Int      @default(0)
}

model AboutPhilosophyItem {
  id           Int      @id @default(autoincrement())
  icon         String
  title        String
  description  String   @db.Text
  displayOrder Int      @default(0)
  isEnabled    Boolean  @default(true)
}

model AboutQualityItem {
  id           Int      @id @default(autoincrement())
  icon         String
  title        String
  description  String   @db.Text
  displayOrder Int      @default(0)
  isEnabled    Boolean  @default(true)
}

model AboutWhyChooseUsItem {
  id           Int      @id @default(autoincrement())
  icon         String?
  title        String
  description  String   @db.Text
  displayOrder Int      @default(0)
  isEnabled    Boolean  @default(true)
}

model AboutValueItem {
  id           Int      @id @default(autoincrement())
  icon         String
  title        String
  description  String   @db.Text
  displayOrder Int      @default(0)
  isEnabled    Boolean  @default(true)
}

model AboutGalleryImage {
  id           Int      @id @default(autoincrement())
  imageUrl     String
  title        String?
  description  String?  @db.Text
  displayOrder Int      @default(0)
  isEnabled    Boolean  @default(true)
}

model AboutCertification {
  id           Int      @id @default(autoincrement())
  imageUrl     String?
  title        String
  description  String?  @db.Text
  issuer       String?
  displayOrder Int      @default(0)
  isEnabled    Boolean  @default(true)
}

model Category {
  id              Int        @id @default(autoincrement())
  name            String     @unique // Keep for backward compatibility
  teluguName      String
  englishName     String     @unique
  teluguSubtitle  String?
  englishSubtitle String?
  description     String?
  imageUrl        String?
  displayOrder    Int        @default(0)
  isEnabled       Boolean    @default(true)
  medicines       Medicine[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Medicine {
  id                Int        @id @default(autoincrement())
  name              String     // Keep for backward compatibility (maps to englishName || teluguName)
  teluguName        String
  englishName       String?
  slug              String     @unique
  description       String
  shortDescription  String?
  price             Float      @default(0.0)
  discountPrice     Float?
  quantity          String?    // e.g. "10 tablets"
  imageUrl          String?    // Optional for raw ingredients
  availability      String     @default("AVAILABLE") // "AVAILABLE", "OUT_OF_STOCK", "HIDDEN"
  whatsappEnabled   Boolean    @default(true)
  displayOrder      Int        @default(0)
  ingredients       String?
  benefits          String?
  usageInstructions String?
  isFeatured        Boolean    @default(false)
  isActive          Boolean    @default(true)
  categories        Category[] // Implicit many-to-many relationship
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Benefit {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  imageUrl     String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Testimonial {
  id           Int      @id @default(autoincrement())
  name         String
  content      String
  rating       Int      @default(5)
  imageUrl     String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Promotion {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  imageUrl    String?
  buttonText  String?
  buttonUrl   String?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model NavigationItem {
  id           Int      @id @default(autoincrement())
  name         String
  url          String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WhatsAppSettings {
  id                     Int      @id @default(1)
  whatsappNumber         String   @default("6305029231")
  defaultMessage         String   @default("Hello, I would like to order {medicineName}. Price: {price}. Quantity: {quantity}.")
  businessName           String   @default("R.K. Ayurveda")
  orderMessageFormat     String   @default("Hello, I would like to order {medicineName}. Price: {price}. Quantity: {quantity}.")
  updatedAt              DateTime @updatedAt
}
